{
  "ignores": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "CHANGELOG.md",
    "docs/adr/**",
    ".freebuff/**",
    ".commandcode/**",
    "specs/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    "MD032": false,
    "MD034": false,
    "MD033": { "allowed_elements": ["img", "br"] },
    "MD041": false
  }
}
